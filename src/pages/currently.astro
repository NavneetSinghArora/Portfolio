---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import bookCover from '../assets/images/AI-Engineering-Book-Cover.jpeg';
import f1Logo from '../assets/icons/F1.svg';

const updatedAt = 'August 2026';

// Grouped by category. Deliberately short — if any one category grows past
// four entries, it has stopped being "currently" and wants its own page.
// Categories render in this order and are skipped entirely when empty, so a
// new one can be added here without touching the markup below.
//
// Names are verbs on purpose. Nouns ("Books", "Sports") read as a permanent
// taxonomy of interests, which is what About is for; the present participle
// keeps these entries reading as things that are true right now and will
// stop being true later — same contract as the page's "Updated when it
// stops being true" and the dated "Before this" list at the bottom.
const categories = [
    {
        name: 'Reading',
        items: [
            {
                name: 'AI Engineering — Chip Huyen',
                // One line each, deliberately. These cards are meant to scan,
                // and a single line keeps them compact without hiding anything
                // behind a hover that touch devices can't perform.
                description: 'Reading it properly, not skimming for the parts I already agree with.',
                // Portrait cover (296×388) — reads as a book, so it gets the
                // rounded corners and shadow a spine-less thumbnail needs.
                image: bookCover,
                imageAlt: 'Cover of AI Engineering by Chip Huyen',
                imageClass: 'w-full rounded-md shadow-md shadow-black/20'
            }
        ]
    },
    {
        name: 'Watching',
        items: [
            {
                name: 'F1 2026',
                description: 'The regulation reset made this the most interesting season in years.',
                // Wide 120×30 wordmark, single #EE0000 fill — legible on both
                // themes as-is, so no light/dark variant and no rounding.
                image: f1Logo,
                imageAlt: 'Formula 1 logo',
                imageClass: 'w-full'
            }
        ]
    }
].filter((category) => category.items.length > 0);

const previously = [
    { when: 'April 2026', what: 'Deep in the Repath agent platform, shader experiments, and expanding the n8n template library.' }
];
---

<BaseLayout
    title="Currently"
    description="What Navneet Singh Arora is working on right now — wrapping up at Repath, taking time off, and reading AI Engineering."
>
    <div class="mb-10">
        <h1 class="font-serif text-3xl leading-tight font-bold sm:text-4xl mb-4 text-main">Currently</h1>
        <p class="text-main/60 max-w-xl leading-relaxed">
            A snapshot of what I'm working on, reading, and thinking about. Updated when it stops being true.
        </p>
        <p class="mt-3 text-[11px] uppercase tracking-widest text-main/70">Last updated: {updatedAt}</p>
    </div>

    <!-- Availability -->
    <div class="mb-14">
        <div class="spotlight-card relative p-6 border-main-border/10 bg-main/5">
            <div class="spotlight-glow opacity-30"></div>
            <div class="flex items-start gap-4">
                <!-- The site has two status colours: emerald = open to
                     opportunities (header), amber = currently / paused but
                     reachable. This dot matches the header's "Currently" pill
                     that links here. -->
                <span class="relative mt-1 flex h-2.5 w-2.5 shrink-0">
                    <span
                        class="absolute inline-flex h-full w-full rounded-full bg-amber-400/30"
                        style="animation: model-blink 2s ease-in-out infinite;"
                    ></span>
                    <span
                        class="relative inline-flex h-2.5 w-2.5 rounded-full bg-amber-400 shadow-[0_0_10px_rgba(251,191,36,0.6)]"
                        style="animation: model-blink 2s ease-in-out infinite;"
                    ></span>
                </span>
                <div>
                    <h2 class="text-sm font-bold text-main mb-1">Taking a break, then looking</h2>
                    <p class="text-sm text-main/60 leading-relaxed max-w-2xl">
                        Some deliberate time off before the next thing. Still happy to hear about senior AI/ML
                        engineering and technical leadership roles — based in Hamburg, open to hybrid or remote
                        across Europe.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- The one thing -->
    <div class="mb-14">
        <h2 class="font-serif text-xl font-bold text-main mb-4">The main thing</h2>
        <div class="max-w-2xl space-y-4 text-main/60 leading-relaxed">
            <p class="text-base text-main/80">
                I'm in my last few weeks at Repath.
            </p>
            <!-- The "time off, then looking" beat lives in the availability
                 card at the top of the page; saying it again here was the same
                 fact twice. This section answers what I'm doing now, the card
                 answers whether I'm available. -->
            <p>
                Most of what's left is handover: closing out the climate-data and agent work so it's legible to
                whoever picks it up next. Less building, more writing things down. It's slower work, and harder
                than it looks.
            </p>
        </div>
    </div>

    <!-- Everything else, by category -->
    {
        categories.map((category) => (
            <div class="mb-14">
                <h2 class="font-serif text-xl font-bold text-main mb-6">{category.name}</h2>
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    {category.items.map((item) => (
                        <div class="spotlight-card group relative flex items-center gap-4 p-5">
                            <div class="spotlight-glow" />
                            {item.image && (
                                <div class="relative z-10 w-20 shrink-0">
                                    {/* astro:assets can't optimise SVGs — they come through as
                                        plain metadata, so the wordmark ships as a raw <img> while
                                        the raster cover goes through <Image> for srcset + webp. */}
                                    {item.image.format === 'svg' ? (
                                        <img src={item.image.src} alt={item.imageAlt} class={item.imageClass} loading="lazy" decoding="async" />
                                    ) : (
                                        <Image
                                            src={item.image}
                                            alt={item.imageAlt}
                                            widths={[80, 160]}
                                            sizes="80px"
                                            class={item.imageClass}
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    )}
                                </div>
                            )}
                            <div class="relative z-10 flex flex-col gap-2">
                                <p class="text-sm font-semibold text-main">{item.name}</p>
                                <p class="text-sm text-main/60 leading-relaxed">{item.description}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        ))
    }

    <!-- Changelog -->
    <div class="mb-20">
        <h2 class="font-serif text-xl font-bold text-main mb-5">Before this</h2>
        <ul class="max-w-2xl space-y-3">
            {
                previously.map((entry) => (
                    <li class="flex flex-col gap-1 border-l border-main-border/20 pl-4 sm:flex-row sm:gap-4">
                        <span class="shrink-0 text-xs uppercase tracking-widest text-main/70 sm:w-28 sm:pt-0.5">
                            {entry.when}
                        </span>
                        <span class="text-sm text-main/60 leading-relaxed">{entry.what}</span>
                    </li>
                ))
            }
        </ul>
    </div>
</BaseLayout>
