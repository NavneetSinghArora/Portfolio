---
import BaseLayout from '../layouts/BaseLayout.astro';

const updatedAt = 'August 2026';

// Deliberately short. If this list grows past four, something has gone wrong.
const alsoNow = [
    {
        name: 'AI Engineering — Chip Huyen',
        description:
            'Just started it. Reading it properly rather than skimming for the parts I already agree with, which is the failure mode with books in this space.'
    },
    {
        name: 'F1 2026',
        description:
            'The regulation reset made this the most interesting season in years. Still following it closely.'
    }
];

const previously = [
    { when: 'April 2026', what: 'Deep in the Repath agent platform, shader experiments, and expanding the n8n template library.' }
];
---

<BaseLayout
    title="Currently"
    description="What Navneet Singh Arora is working on right now — wrapping up at Repath, taking time off, and reading AI Engineering."
>
    <div class="mb-10">
        <h1 class="font-serif text-3xl leading-tight font-bold sm:text-4xl mb-4 text-main">Currently</h1>
        <p class="text-main/60 max-w-xl leading-relaxed">
            A snapshot of what I'm working on, reading, and thinking about. Updated when it stops being true.
        </p>
        <p class="mt-3 text-[11px] uppercase tracking-widest text-main/70">Last updated: {updatedAt}</p>
    </div>

    <!-- Availability -->
    <div class="mb-14">
        <div class="spotlight-card relative p-6 border-main-border/10 bg-main/5">
            <div class="spotlight-glow opacity-30"></div>
            <div class="flex items-start gap-4">
                <span
                    class="mt-1 flex h-2.5 w-2.5 shrink-0 rounded-full bg-main shadow-[0_0_10px_rgba(128,128,128,0.5)]"
                    style="animation: model-blink 2s ease-in-out infinite;"
                ></span>
                <div>
                    <h2 class="text-sm font-bold text-main mb-1">Taking a break, then looking</h2>
                    <p class="text-sm text-main/60 leading-relaxed max-w-2xl">
                        Some deliberate time off before the next thing. Still happy to hear about senior AI/ML
                        engineering and technical leadership roles — based in Hamburg, open to hybrid or remote
                        across Europe.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- The one thing -->
    <div class="mb-14">
        <h2 class="font-serif text-xl font-bold text-main mb-4">The main thing</h2>
        <div class="max-w-2xl space-y-4 text-main/60 leading-relaxed">
            <p class="text-base text-main/80">
                Wrapping up my last weeks at Repath. I'm leaving the company.
            </p>
            <p>
                Most of what's left is handover — closing out the climate-data and agent work so it's legible to
                whoever picks it up next. Less building, more writing things down. It's a slower kind of work and
                genuinely harder to do well.
            </p>
            <p>
                After that, time off. Not a sabbatical with a reading list and a plan attached — actual time off.
                Whatever comes next starts fresh rather than picking up where this left off.
            </p>
        </div>
    </div>

    <!-- Everything else -->
    <div class="mb-14">
        <h2 class="font-serif text-xl font-bold text-main mb-6">Also</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {
                alsoNow.map((item) => (
                    <div class="spotlight-card group relative flex flex-col gap-2 p-5">
                        <div class="spotlight-glow" />
                        <p class="text-sm font-semibold text-main">{item.name}</p>
                        <p class="text-sm text-main/60 leading-relaxed">{item.description}</p>
                    </div>
                ))
            }
        </div>
    </div>

    <!-- Changelog -->
    <div class="mb-20">
        <h2 class="font-serif text-xl font-bold text-main mb-5">Before this</h2>
        <ul class="max-w-2xl space-y-3">
            {
                previously.map((entry) => (
                    <li class="flex flex-col gap-1 border-l border-main-border/20 pl-4 sm:flex-row sm:gap-4">
                        <span class="shrink-0 text-xs uppercase tracking-widest text-main/70 sm:w-28 sm:pt-0.5">
                            {entry.when}
                        </span>
                        <span class="text-sm text-main/60 leading-relaxed">{entry.what}</span>
                    </li>
                ))
            }
        </ul>
    </div>
</BaseLayout>
