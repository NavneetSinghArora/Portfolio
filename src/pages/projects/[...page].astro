---
export const prerender = true;
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import Pagination from '../../components/Pagination.astro';
import ProjectThumbnail from '../../components/ProjectThumbnail.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import IconButton from '../../components/IconButton.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';
import LayoutGrid from '../../assets/icons/layout-grid.svg';
import npmIcon from '../../assets/icons/npm.svg';
import ListIcon from '../../assets/icons/list.svg';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
    return paginate(projects, { pageSize: siteConfig.projectsPerPage || 12 });
}

type Props = { page: Page<CollectionEntry<'projects'>> };

const { page } = Astro.props;
const portfolio = page.data;
const allTags = [...new Set(portfolio.flatMap(p => p.data.tags))].sort();
const tier1 = portfolio.filter(p => p.data.isFeatured);
const tier2 = portfolio.filter(p => !p.data.isFeatured);

// Order values keep tier grouping intact through client-side re-sorting (CSS `order`, not DOM moves).
const TIER2_OFFSET = 1000;
const orderFor = (project: CollectionEntry<'projects'>) => {
    const list = project.data.isFeatured ? tier1 : tier2;
    const base = project.data.isFeatured ? 1 : TIER2_OFFSET + 1;
    return base + list.indexOf(project);
};

---

<BaseLayout title="Projects" description="Research projects and shipped products by Navneet Singh Arora — spanning robotics, computer vision, NLP, multi-agent AI, and real-world automation workflows.">
    <div class="mb-20 sm:mb-24 flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
        <div>
            <h1 class="font-serif text-2xl leading-tight sm:text-4xl text-main">Projects</h1>
            <p class="mt-2 text-sm text-main/60 max-w-md">Technical research, engineering implementations, and academic reviews.</p>
        </div>
    </div>

    <!-- Filter console — search leads on its own row, refinements sit below.
         Controls share a raised surface so they separate from the page in both themes. -->
    <div class="mb-20 space-y-3">
        <!-- Search -->
        <div class="group relative">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-main/60 transition-colors group-focus-within:text-main"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input
                type="text"
                id="project-search"
                placeholder="Search projects by name, tag, or technology…"
                class="h-12 w-full rounded-xl border border-main-border/15 bg-surface pl-11 pr-4 text-sm text-main placeholder:text-main/60 transition-colors focus:outline-none focus:border-main/30 focus-visible:ring-2 focus-visible:ring-main/20"
            />
        </div>

        <!-- Refinements -->
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-3">
                <!-- Category -->
                <div class="dropdown-container relative" id="category-dropdown">
                    <button class="dropdown-trigger flex h-11 min-w-[168px] items-center justify-between gap-3 rounded-xl border border-main-border/15 bg-surface px-4 text-sm font-medium text-main/70 transition-colors hover:text-main focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-main/20">
                        <span id="current-category">All Categories</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron h-3.5 w-3.5 text-main/60 transition-transform"><path d="m6 9 6 6 6-6"></path></svg>
                    </button>

                    <div class="dropdown-menu hidden absolute top-full left-0 z-50 mt-2 max-h-[min(24rem,60vh)] min-w-[220px] origin-top-left overflow-y-auto overscroll-contain rounded-xl border border-main-border/15 bg-surface py-1.5 shadow-xl transition-all duration-200">
                        <button class="tag-filter-btn flex w-full items-center gap-3 px-4 py-2 text-[13px] text-main/70 transition-colors hover:text-main" data-tag-filter="all">
                            <div class="active-indicator h-1.5 w-1.5 shrink-0 rounded-full bg-main opacity-0 transition-opacity"></div>
                            All Projects
                        </button>
                        {allTags.map(tag => (
                            <button class="tag-filter-btn flex w-full items-center gap-3 px-4 py-2 text-[13px] capitalize text-main/70 transition-colors hover:text-main" data-tag-filter={tag}>
                                <div class="active-indicator h-1.5 w-1.5 shrink-0 rounded-full bg-main opacity-0 transition-opacity"></div>
                                {tag}
                            </button>
                        ))}
                    </div>
                </div>

                <!-- Sort -->
                <div class="dropdown-container relative" id="sort-dropdown">
                    <button class="dropdown-trigger flex h-11 min-w-[150px] items-center justify-between gap-3 rounded-xl border border-main-border/15 bg-surface px-4 text-sm font-medium text-main/70 transition-colors hover:text-main focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-main/20">
                        <span id="current-sort">Newest First</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron h-3.5 w-3.5 text-main/60 transition-transform"><path d="m6 9 6 6 6-6"></path></svg>
                    </button>
                    <div class="dropdown-menu hidden absolute top-full left-0 z-50 mt-2 min-w-[200px] origin-top-left rounded-xl border border-main-border/15 bg-surface py-1.5 shadow-xl transition-all duration-200">
                        <button class="sort-btn flex w-full items-center gap-3 px-4 py-2 text-[13px] text-main/70 transition-colors hover:text-main" data-sort="newest">
                            <div class="active-indicator h-1.5 w-1.5 shrink-0 rounded-full bg-main opacity-100 transition-opacity"></div>
                            Newest First
                        </button>
                        <button class="sort-btn flex w-full items-center gap-3 px-4 py-2 text-[13px] text-main/70 transition-colors hover:text-main" data-sort="oldest">
                            <div class="active-indicator h-1.5 w-1.5 shrink-0 rounded-full bg-main opacity-0 transition-opacity"></div>
                            Oldest First
                        </button>
                        <button class="sort-btn flex w-full items-center gap-3 px-4 py-2 text-[13px] text-main/70 transition-colors hover:text-main" data-sort="az">
                            <div class="active-indicator h-1.5 w-1.5 shrink-0 rounded-full bg-main opacity-0 transition-opacity"></div>
                            Alphabetical (A–Z)
                        </button>
                    </div>
                </div>
            </div>

            <!-- View switcher -->
            <div class="view-switcher-container relative flex items-center gap-1 rounded-xl border border-main-border/15 bg-surface p-1.5">
                <div class="view-highlight absolute rounded-lg bg-main/10 transition-all duration-300 ease-out"></div>
                <button
                    id="view-cards"
                    class="view-mode-btn premium-tooltip active-view relative z-10 flex h-8 w-8 items-center justify-center rounded-lg transition-colors"
                    data-tooltip="Grid"
                    aria-label="Grid view"
                >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                </button>
                <button
                    id="view-gallery"
                    class="view-mode-btn premium-tooltip relative z-10 flex h-8 w-8 items-center justify-center rounded-lg text-main/40 transition-colors"
                    data-tooltip="Gallery"
                    aria-label="Gallery view"
                >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                </button>
                <button
                    id="view-list"
                    class="view-mode-btn premium-tooltip relative z-10 flex h-8 w-8 items-center justify-center rounded-lg text-main/40 transition-colors"
                    data-tooltip="List"
                    aria-label="List view"
                >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Gallery View Container (Horizontal List / Visual List) -->
    <div id="gallery-container" class="hidden flex flex-col gap-6 transition-all duration-300">
        {tier1.length > 0 && (
            <div class="tier-heading flex items-center gap-3" style="order:0">
                <h2 class="font-serif text-lg font-bold text-main">Systems</h2>
                <div class="h-px flex-1 bg-main-border/10"></div>
            </div>
        )}
        {tier2.length > 0 && (
            <div class="tier-heading flex items-center gap-3" style={`order:${TIER2_OFFSET}`}>
                <h2 class="font-serif text-lg font-bold text-main/70">Research &amp; Academic</h2>
                <div class="h-px flex-1 bg-main-border/10"></div>
            </div>
        )}
        {portfolio.map((project) => (
            <div
                class="project-item project-card spotlight-card group relative flex flex-col sm:flex-row gap-6 p-6"
                data-tags={project.data.tags.join(',')}
                data-date={project.data.publishDate.getTime()}
                data-title={project.data.title.toLowerCase()}
                data-tier={project.data.isFeatured ? '1' : '2'}
                style={`order:${orderFor(project)}`}
            >
                <div class="spotlight-glow"></div>
                <!-- Base Link Overlay -->
                <a href={`/projects/${project.id}/`} class="absolute inset-0 z-10" aria-label={`View ${project.data.title}`}></a>
                
                <!-- Visual Column (Left) -->
                <div class="w-full sm:w-64 shrink-0 relative z-1">
                    <a href={`/projects/${project.id}/`} class="block aspect-video sm:aspect-square rounded-xl overflow-hidden border border-main-border/5">
                        {project.data.seo?.image ? (
                            <img
                                src={project.data.seo.image.src.src}
                                alt={project.data.title}
                                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                            />
                        ) : project.data.npm ? (
                            <div class="flex h-full w-full flex-col items-center justify-center gap-3 bg-[#0f0f1a] px-4 py-4">
                                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#CB3837]/40 bg-[#CB3837]/10 px-3 py-1 text-[10px] font-mono font-bold text-[#CB3837] tracking-widest uppercase">
                                    <img src={npmIcon.src} class="h-3 w-3" alt="" />
                                    npm
                                </span>
                                <span class="font-mono text-base font-bold text-white/90 tracking-tight">{project.data.npm.split('/package/')[1]?.split('/')[0]}</span>
                                <span class="font-mono text-[10px] text-white/80 bg-white/5 rounded-lg px-3 py-1.5 border border-white/5">
                                    <span class="text-white/30">$ </span>npm i {project.data.npm.split('/package/')[1]?.split('/')[0]}
                                </span>
                            </div>
                        ) : (
                            <div class="flex h-full w-full items-center justify-center bg-main-bg/10 text-main/60 text-xs">No preview</div>
                        )}
                    </a>
                </div>

                <!-- Content Section (Right) -->
                <div class="flex-grow flex flex-col justify-between py-1">
                    <div>
                        <a href={`/projects/${project.id}/`}>
                            <h3 class="font-serif text-2xl font-bold leading-tight mb-3 text-main">
                                <span class="premium-line-hover">{project.data.title}</span>
                            </h3>
                        </a>
                        <p class="text-sm text-main/60 leading-relaxed font-sans line-clamp-3">
                            {project.data.description}
                        </p>
                    </div>

                    <div class="mt-6 flex items-center justify-between">
                        <div class="flex items-center gap-1.5 z-20 relative">
                            {project.data.github && (
                                <IconButton href={project.data.github} target="_blank" rel="noopener noreferrer" size="md" tooltip="GitHub">
                                    <SocialIcon name="github" />
                                </IconButton>
                            )}
                            {project.data.npm && (
                                <IconButton href={project.data.npm} target="_blank" rel="noopener noreferrer" size="md" tooltip="npm Package">
                                    <SocialIcon name="npm" />
                                </IconButton>
                            )}
                            {project.data.paper && (
                                <IconButton href={project.data.paper} target="_blank" rel="noopener noreferrer" size="md" tooltip={project.data.paper.includes('kaggle.com') ? 'Kaggle Competition' : 'Research Paper'}>
                                    <SocialIcon name={project.data.paper.includes('kaggle.com') ? 'kaggle' : 'paper'} />
                                </IconButton>
                            )}
                            {project.data.demo && (
                                <IconButton href={project.data.demo} target="_blank" rel="noopener noreferrer" size="md" tooltip="Live Demo">
                                    <SocialIcon name="demo" />
                                </IconButton>
                            )}
                            {project.data.external && (
                                <IconButton href={project.data.external} target="_blank" rel="noopener noreferrer" size="md" tooltip={project.data.tags.includes('n8n') ? 'n8n Workflow' : 'External Link'}>
                                    <SocialIcon name={project.data.tags.includes('n8n') ? 'n8n' : 'external'} />
                                </IconButton>
                            )}
                        </div>
                        <span class="text-[10px] font-bold tracking-[0.15em] text-main/70 uppercase font-sans">YEAR {project.data.publishDate.getFullYear()}</span>
                    </div>
                </div>
            </div>
        ))}
    </div>

    <!-- Cards View Container (Detailed Grid) - DEFAULT -->
    <div id="cards-container" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 transition-all duration-300">
        {tier1.length > 0 && (
            <div class="tier-heading col-span-full flex items-center gap-3" style="order:0">
                <h2 class="font-serif text-lg font-bold text-main">Systems</h2>
                <div class="h-px flex-1 bg-main-border/10"></div>
            </div>
        )}
        {tier2.length > 0 && (
            <div class="tier-heading col-span-full flex items-center gap-3" style={`order:${TIER2_OFFSET}`}>
                <h2 class="font-serif text-lg font-bold text-main/70">Research &amp; Academic</h2>
                <div class="h-px flex-1 bg-main-border/10"></div>
            </div>
        )}
        {portfolio.map((project) => (
            <div
                class="project-item project-card spotlight-card group relative flex flex-col p-4 shadow-sm"
                data-tags={project.data.tags.join(',')}
                data-date={project.data.publishDate.getTime()}
                data-title={project.data.title.toLowerCase()}
                data-tier={project.data.isFeatured ? '1' : '2'}
                style={`order:${orderFor(project)}`}
            >
                <div class="spotlight-glow"></div>
                <!-- Base Link Overlay -->
                <a href={`/projects/${project.id}/`} class="absolute inset-0 z-10" aria-label={`View ${project.data.title}`}></a>
                
                <div class="flex-grow relative z-1">
                    <div class="aspect-video w-full overflow-hidden rounded-xl border border-main-border/5 bg-main-bg/10 mb-4">
                        {project.data.seo?.image ? (
                            <img
                                src={project.data.seo.image.src.src}
                                alt={project.data.title}
                                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                            />
                        ) : project.data.npm ? (
                            <div class="flex h-full w-full flex-col items-center justify-center gap-3 bg-[#0f0f1a] px-4 py-6">
                                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#CB3837]/40 bg-[#CB3837]/10 px-3 py-1 text-[10px] font-mono font-bold text-[#CB3837] tracking-widest uppercase">
                                    <img src={npmIcon.src} class="h-3 w-3" alt="" />
                                    npm
                                </span>
                                <span class="font-mono text-lg font-bold text-white/90 tracking-tight">{project.data.npm.split('/package/')[1]?.split('/')[0]}</span>
                                <span class="font-mono text-[11px] text-white/80 bg-white/5 rounded-lg px-3 py-1.5 border border-white/5">
                                    <span class="text-white/30">$ </span>npm i {project.data.npm.split('/package/')[1]?.split('/')[0]}
                                </span>
                            </div>
                        ) : (
                            <div class="flex h-full w-full items-center justify-center text-main/60 text-xs">No preview</div>
                        )}
                    </div>
                    <h3 class="font-serif text-base font-bold leading-tight line-clamp-2 py-0.5 mb-2 text-main">
                        <span class="premium-line-hover">{project.data.title}</span>
                    </h3>
                    {project.data.description && (
                        <p class="text-xs text-main/90 line-clamp-3 mb-4 leading-relaxed font-sans">{project.data.description}</p>
                    )}
                </div>
                
                <!-- Card Meta -->
                <div class="mt-auto flex items-center justify-between pt-3 border-t border-main-border/5">
                    <div class="flex items-center gap-1.5 z-20 relative">
                        {project.data.github && (
                            <IconButton href={project.data.github} target="_blank" rel="noopener noreferrer" size="md" tooltip="GitHub">
                                <SocialIcon name="github" />
                            </IconButton>
                        )}
                        {project.data.npm && (
                            <IconButton href={project.data.npm} target="_blank" rel="noopener noreferrer" size="md" tooltip="npm Package">
                                <SocialIcon name="npm" />
                            </IconButton>
                        )}
                        {project.data.paper && (
                            <IconButton href={project.data.paper} target="_blank" rel="noopener noreferrer" size="md" tooltip={project.data.paper.includes('kaggle.com') ? 'Kaggle Competition' : 'Research Paper'}>
                                <SocialIcon name={project.data.paper.includes('kaggle.com') ? 'kaggle' : 'paper'} />
                            </IconButton>
                        )}
                        {project.data.demo && (
                            <IconButton href={project.data.demo} target="_blank" rel="noopener noreferrer" size="md" tooltip="Live Demo">
                                <SocialIcon name="demo" />
                            </IconButton>
                        )}
                        {project.data.external && (
                            <IconButton href={project.data.external} target="_blank" rel="noopener noreferrer" size="md" tooltip={project.data.tags.includes('n8n') ? 'n8n Workflow' : 'External Link'}>
                                <SocialIcon name={project.data.tags.includes('n8n') ? 'n8n' : 'external'} />
                            </IconButton>
                        )}
                    </div>
                    <span class="text-[10px] font-bold tracking-[0.15em] text-main/70 uppercase font-sans">YEAR {project.data.publishDate.getFullYear()}</span>
                </div>
            </div>
        ))}
    </div>

    <div id="list-container" class="hidden flex flex-col gap-4 transition-all duration-300">
        {tier1.length > 0 && (
            <div class="tier-heading flex items-center gap-3" style="order:0">
                <h2 class="font-serif text-lg font-bold text-main">Systems</h2>
                <div class="h-px flex-1 bg-main-border/10"></div>
            </div>
        )}
        {tier2.length > 0 && (
            <div class="tier-heading flex items-center gap-3" style={`order:${TIER2_OFFSET}`}>
                <h2 class="font-serif text-lg font-bold text-main/70">Research &amp; Academic</h2>
                <div class="h-px flex-1 bg-main-border/10"></div>
            </div>
        )}
        {portfolio.map((project) => (
            <div
                class="project-item group"
                data-tags={project.data.tags.join(',')}
                data-tier={project.data.isFeatured ? '1' : '2'}
                style={`order:${orderFor(project)}`}
            >
                <ProjectPreview project={project} />
            </div>
        ))}
    </div>

    <Pagination page={page} class="my-16 sm:my-24" />
</BaseLayout>

<style>
    @reference "../../styles/global.css";
    /* The sliding `.view-highlight` carries the active background, so the active
       button only needs to change its ink — no second filled block on top of it. */
    .active-view {
        @apply text-main;
    }
    .tag-filter-btn:hover,
    .sort-btn:hover {
        @apply bg-main/5;
    }
    .active-tag {
        @apply bg-main text-main-bg border-main shadow-lg shadow-main/20 scale-105;
    }
    .active-tag svg {
        @apply text-main-bg opacity-100;
    }
</style>

<script>
    function initViewSwitcher() {
        const galleryBtn = document.getElementById('view-gallery');
        const cardsBtn = document.getElementById('view-cards');
        const listBtn = document.getElementById('view-list');
        
        const galleryContainer = document.getElementById('gallery-container');
        const cardsContainer = document.getElementById('cards-container');
        const listContainer = document.getElementById('list-container');

        const buttons = [galleryBtn, cardsBtn, listBtn];
        const containers = [galleryContainer, cardsContainer, listContainer];

        if (buttons.some(b => !b) || containers.some(c => !c)) return;

        // Check local storage for saved preference, default to cards
        const savedView = localStorage.getItem('projects-view') || 'cards';
        switchTo(savedView as any);

        galleryBtn?.addEventListener('click', () => switchTo('gallery'));
        cardsBtn?.addEventListener('click', () => switchTo('cards'));
        listBtn?.addEventListener('click', () => switchTo('list'));

        function switchTo(view: 'gallery' | 'cards' | 'list') {
            containers.forEach(c => c?.classList.add('hidden'));
            buttons.forEach(b => {
                if (b) {
                    b.classList.remove('active-view');
                    b.classList.add('text-main/40');
                }
            });

            const activeContainer = document.getElementById(`${view}-container`);
            const activeBtn = document.getElementById(`view-${view}`);
            const highlight = document.querySelector('.view-highlight') as HTMLElement;

            if (activeBtn && highlight) {
                const bRect = activeBtn.getBoundingClientRect();
                const cRect = highlight.parentElement!.getBoundingClientRect();
                highlight.style.width = `${bRect.width}px`;
                highlight.style.height = `${bRect.height}px`;
                highlight.style.left = `${bRect.left - cRect.left}px`;
                highlight.style.top = `${bRect.top - cRect.top}px`;
            }

            activeContainer?.classList.remove('hidden');
            if (activeBtn) {
                activeBtn.classList.remove('text-main/40');
                activeBtn.classList.add('active-view');
            }
            
            localStorage.setItem('projects-view', view);
        }
    }

    // Dropdown Handling
    const dropdowns = document.querySelectorAll('.dropdown-container');
    
    dropdowns.forEach(dropdown => {
        const trigger = dropdown.querySelector('.dropdown-trigger');
        const menu = dropdown.querySelector('.dropdown-menu');
        const chevron = dropdown.querySelector('.chevron');

        trigger?.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = menu?.classList.contains('hidden');
            
            // Close all
            dropdowns.forEach(other => {
                other.querySelector('.dropdown-menu')?.classList.add('hidden');
                other.querySelector('.chevron')?.classList.remove('rotate-180');
            });

            if (isHidden) {
                menu?.classList.remove('hidden');
                chevron?.classList.add('rotate-180');
            }
        });
    });

    document.addEventListener('click', () => {
        dropdowns.forEach(dropdown => {
            dropdown.querySelector('.dropdown-menu')?.classList.add('hidden');
            dropdown.querySelector('.chevron')?.classList.remove('rotate-180');
        });
    });

    // Filtering & Search Logic
    const filterButtons = document.querySelectorAll('.tag-filter-btn');
    const sortButtons = document.querySelectorAll('.sort-btn');
    const projectSearch = document.getElementById('project-search') as HTMLInputElement;
    const projectCards = document.querySelectorAll<HTMLElement>('.project-item');

    let currentCategory = 'all';
    let currentSort = 'newest';
    let searchQuery = '';

    // Sorting sets CSS `order` per tier group (rather than moving DOM nodes) so the
    // Systems / Research & Academic grouping survives re-sorting.
    function sortProjects() {
        const containers = [
            document.getElementById('cards-container'),
            document.getElementById('gallery-container'),
            document.getElementById('list-container')
        ];

        const comparator = (a: HTMLElement, b: HTMLElement) => {
            if (currentSort === 'az') {
                return (a.dataset.title || '').localeCompare(b.dataset.title || '');
            }
            const dateA = parseInt(a.dataset.date || '0');
            const dateB = parseInt(b.dataset.date || '0');
            return currentSort === 'newest' ? dateB - dateA : dateA - dateB;
        };

        containers.forEach(container => {
            if (!container) return;

            const cardArray = Array.from(container.querySelectorAll<HTMLElement>('.project-item'));
            const tier1Cards = cardArray.filter(c => c.dataset.tier !== '2').sort(comparator);
            const tier2Cards = cardArray.filter(c => c.dataset.tier === '2').sort(comparator);

            tier1Cards.forEach((card, i) => { card.style.order = String(i + 1); });
            tier2Cards.forEach((card, i) => { card.style.order = String(1001 + i); });
        });
    }

    function applyFilters() {
        projectCards.forEach(card => {
            const tags = (card.dataset.tags || '').split(',');
            const title = card.querySelector('h3')?.textContent?.toLowerCase() || '';
            const desc = card.querySelector('p')?.textContent?.toLowerCase() || '';

            const matchesCategory = currentCategory === 'all' || tags.includes(currentCategory);
            const matchesSearch = title.includes(searchQuery) || desc.includes(searchQuery) || tags.some(t => t.includes(searchQuery));

            if (matchesCategory && matchesSearch) {
                card.classList.remove('hidden');
                card.style.display = '';
            } else {
                card.classList.add('hidden');
                card.style.display = 'none';
            }
        });

        // Hide a tier heading if every card in that tier is currently filtered out.
        document.querySelectorAll<HTMLElement>('.tier-heading').forEach(heading => {
            const container = heading.parentElement;
            const tier = heading.style.order === '0' ? '1' : '2';
            const anyVisible = Array.from(container?.querySelectorAll<HTMLElement>(`.project-item[data-tier="${tier}"]`) || [])
                .some(c => !c.classList.contains('hidden'));
            heading.style.display = anyVisible ? '' : 'none';
        });

        sortProjects();
    }

    filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            currentCategory = (btn as HTMLElement).dataset.tagFilter!;
            
            // UI Updates
            filterButtons.forEach(b => {
                const indicator = b.querySelector('.active-indicator');
                b.classList.remove('text-main');
                b.classList.add('text-main/60');
                indicator?.classList.remove('opacity-100');
                indicator?.classList.add('opacity-0');
            });
            btn.classList.add('text-main');
            btn.classList.remove('text-main/60');
            btn.querySelector('.active-indicator')?.classList.remove('opacity-0');
            btn.querySelector('.active-indicator')?.classList.add('opacity-100');

            const label = document.getElementById('current-category');
            if (label) label.textContent = btn.textContent?.trim() || 'All Categories';
            applyFilters();
        });
    });

    sortButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            currentSort = (btn as HTMLElement).dataset.sort!;

            // UI Updates
            sortButtons.forEach(b => {
                const indicator = b.querySelector('.active-indicator');
                b.classList.remove('text-main');
                b.classList.add('text-main/60');
                indicator?.classList.remove('opacity-100');
                indicator?.classList.add('opacity-0');
            });
            btn.classList.add('text-main');
            btn.classList.remove('text-main/60');
            btn.querySelector('.active-indicator')?.classList.remove('opacity-0');
            btn.querySelector('.active-indicator')?.classList.add('opacity-100');

            const label = document.getElementById('current-sort');
            if (label) label.textContent = btn.textContent?.trim() || 'Newest';
            applyFilters();
        });
    });

    projectSearch?.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
        applyFilters();
    });

    // Init on first load
    initViewSwitcher();
    // Re-init on page navigation
    document.addEventListener('astro:page-load', initViewSwitcher);
</script>
