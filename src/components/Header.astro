---
import siteConfig from '../data/site-config';
import CustomImage from './CustomImage.astro';
import QuickConnect from './QuickConnect.astro';
import IconButton from './IconButton.astro';
import SocialIcon from './SocialIcon.astro';

// Dynamically import all logos from src/assets/icons to ensure they are bundled correctly
const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/icons/*.{svg,png,webp,jpg,jpeg}', { eager: true });

function resolveIcon(name: string | undefined) {
    if (!name) return '';
    if (name.startsWith('http')) return name;

    const extensions = ['.svg', '.png', '.webp', '.jpg', '.jpeg'];
    for (const ext of extensions) {
        const path = `/src/assets/icons/${name}${ext}`;
        const asset = logos[path];
        if (asset) {
            return (asset.default as any)?.src || asset.default || asset;
        }
    }
    return '';
}

type KnownIcon = 'github' | 'npm' | 'medium' | 'kaggle' | 'n8n';
const knownIcons: KnownIcon[] = ['github', 'npm', 'medium', 'kaggle', 'n8n'];

const titleClass = 'text-theme-foreground font-serif text-3xl leading-tight font-medium sm:text-4xl lg:text-5xl';
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
---

<header class={`relative mx-auto flex w-full max-w-4xl flex-col items-center text-center gap-6 ${isHome ? 'min-h-[calc(100svh-6rem)] sm:min-h-[calc(100svh-8rem)] justify-center mb-8' : 'mb-12 sm:mb-16'}`}>
    {
        siteConfig.avatar?.src && (
            <a href="/" class="mb-2">
                <CustomImage
                    class="aspect-square w-32 rounded-full object-cover sm:w-40 shadow-xl ring-2 ring-main-border/10 transition-transform duration-500 hover:scale-105"
                    {...siteConfig.avatar}
                    loading="eager"
                    fetchpriority="high"
                    width={160}
                    height={160}
                    widths={[160, 320]}
                    sizes="160px"
                />
            </a>
        )
    }
    <div class="flex flex-col items-center w-full">
        {
            siteConfig.avatar?.src ? (
                <p class={titleClass}>{siteConfig.title}</p>
            ) : (
                <a class={titleClass} href="/">
                    {siteConfig.title}
                </a>
            )
        }
        <div class="flex flex-col items-center gap-3 mb-6">
            <p id="header-subtitle" class="text-base sm:text-lg leading-tight font-semibold tracking-wide text-main/80" aria-label={siteConfig.subtitle}>
                <span id="typewriter-text" aria-hidden="true">{siteConfig.subtitle}</span><span id="typewriter-cursor" class="inline-block w-[2px] h-[1.1em] bg-main align-middle ml-[2px]" aria-hidden="true"></span>
            </p>
            <div class="flex items-center gap-1.5 text-main/60 font-medium text-[10px] uppercase tracking-[0.2em] mt-1 mb-2">
                <svg class="w-3.5 h-3.5 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <span>Hamburg, Germany</span>
            </div>
        </div>
        
        <div class="flex flex-wrap justify-center items-center gap-3">
            {siteConfig.socialLinks?.map((link) => {
                let iconName = link.text.toLowerCase();
                if (iconName.includes('n8n')) iconName = 'n8n';

                const isKnown = knownIcons.includes(iconName as KnownIcon);
                const isResume = iconName === 'resume';

                return (
                    <IconButton href={link.href} target="_blank" rel="noopener noreferrer" variant="header" size="xl" tooltip={link.text}>
                        {isKnown ? (
                            <SocialIcon name={iconName as KnownIcon} size="lg" />
                        ) : isResume ? (
                            <img src={resolveIcon('resume-clipboard')} alt={link.text} class="h-6 w-6 sm:h-7 sm:w-7" />
                        ) : (
                            <img src={resolveIcon(iconName)} alt={link.text} class="h-6 w-6 sm:h-7 sm:w-7" />
                        )}
                    </IconButton>
                );
            })}
            <div class="flex items-center ml-2">
                <QuickConnect />
            </div>
        </div>

        <!-- Unified Presence Dashboard -->
        <div class="mt-10 flex justify-center">
            <div class="group/bar relative flex max-w-full flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:gap-4 px-5 py-2 rounded-xl border border-main-border/20 bg-surface/70 backdrop-blur-md shadow-sm overflow-hidden transition-all duration-700 hover:border-main-border/40 hover:bg-surface dark:shadow-2xl dark:shadow-black/20">
                <div class="absolute inset-0 bg-gradient-to-br from-main/[0.03] to-transparent pointer-events-none"></div>
                
                <!-- Status: Opportunity -->
                <div class="flex items-center gap-2.5">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400/30"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
                    </span>
                    <span class="text-[10px] font-mono leading-none font-medium uppercase tracking-[0.2em] text-main/80 whitespace-nowrap">Open to Opportunities</span>
                </div>

                <div class="h-px w-full bg-main-border/20 sm:h-3 sm:w-px"></div>

                <!-- Status: Currently -->
                <a href="/currently" class="group/now relative -mx-5 px-5 py-1 sm:-my-2 sm:mx-0 sm:-mr-5 sm:py-2 flex items-center gap-2.5 transition-all duration-300 hover:bg-main/5">
                    <span class="relative flex h-2 w-2">
                        <span class="rounded-full h-2 w-2 bg-sky-400/80 border border-sky-400 group-hover/now:scale-110 transition-transform"></span>
                    </span>
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-mono leading-none font-medium uppercase tracking-[0.2em] text-main/60 group-hover/now:text-main transition-colors whitespace-nowrap">Currently: Wrapping up at Repath</span>
                        <svg class="w-2.5 h-2.5 text-main/40 group-hover/now:text-main group-hover/now:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                        </svg>
                    </div>
                </a>

                <!-- Corner Accent -->
                <div class="absolute top-0 right-0 p-1 opacity-20">
                    <svg width="6" height="6" viewBox="0 0 6 6" fill="none" class="text-main"><path d="M6 0V6H0" stroke="currentColor" stroke-width="0.5"/></svg>
                </div>
            </div>
        </div>
    </div>

    {isHome && (
        <button
            id="scroll-indicator"
            type="button"
            aria-label="Scroll to content"
            class="absolute bottom-4 left-1/2 -translate-x-1/2 animate-bounce flex flex-col items-center gap-2 opacity-50 transition-opacity duration-500 hover:opacity-100 cursor-pointer"
        >
            <span class="text-[10px] sm:text-xs uppercase tracking-[0.2em] font-medium opacity-70">Explore More</span>
            <svg class="w-5 h-5 text-main/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
        </button>
    )}
</header>

<script>
    // Module-level guard — prevents two async loops running concurrently.
    // astro:page-load fires on initial load AND navigations, so we never
    // call initTypewriter() directly — only via the event listener.
    let twActive = false;

    const sleep = (ms: number) => new Promise<void>(r => setTimeout(r, ms));

    async function initTypewriter() {
        if (twActive) return;
        twActive = true;

        const textEl = document.getElementById('typewriter-text') as HTMLElement | null;
        const cursor  = document.getElementById('typewriter-cursor') as HTMLElement | null;
        if (!textEl || !cursor) { twActive = false; return; }

        const phrases = [
            'Senior AI Engineer · Agentic Systems & RAG',
            'Multi-Agent Orchestration in Production',
            'LangGraph · FastMCP · Qdrant · FastAPI',
        ];

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            textEl.textContent = phrases[0];
            cursor.style.display = 'none';
            twActive = false;
            return;
        }

        // Cursor blink via CSS
        if (!document.getElementById('tw-style')) {
            const s = document.createElement('style');
            s.id = 'tw-style';
            s.textContent = '@keyframes tw-blink{0%,100%{opacity:1}50%{opacity:0}}';
            document.head.appendChild(s);
        }
        cursor.style.animation = 'tw-blink 1s step-end infinite';

        let alive = true;
        let phraseIdx = 0;

        // Stop loop on page navigation
        document.addEventListener('astro:before-swap', () => {
            alive = false;
            twActive = false;
        }, { once: true });

        // Initial hold — show the first phrase fully before starting
        await sleep(2800);

        while (alive) {
            const current = phrases[phraseIdx];

            // Delete char by char using an explicit counter (not textContent.length)
            for (let len = current.length; len >= 0 && alive; len--) {
                textEl.textContent = current.slice(0, len);
                await sleep(28);
            }

            if (!alive) break;

            // Advance to next phrase
            phraseIdx = (phraseIdx + 1) % phrases.length;
            const next = phrases[phraseIdx];

            // Type char by char
            for (let i = 1; i <= next.length && alive; i++) {
                textEl.textContent = next.slice(0, i);
                await sleep(62);
            }

            if (!alive) break;

            // Hold the completed phrase
            await sleep(2800);
        }

        twActive = false;
    }

    // astro:page-load covers both initial load (with ClientRouter) and navigations
    document.addEventListener('astro:page-load', () => {
        twActive = false; // reset in case previous instance leaked
        initTypewriter();
    });

    function scrollHandler() {
        const indicator = document.getElementById('scroll-indicator');
        if (!indicator) return;

        if (window.scrollY > 50) {
            indicator.style.opacity = '0';
            indicator.style.pointerEvents = 'none';
        } else {
            indicator.style.opacity = '0.5';
            indicator.style.pointerEvents = 'auto';
        }
    }

    // Attach listener
    window.addEventListener('scroll', scrollHandler, { passive: true });

    // Check initial state
    scrollHandler();

    // Skip straight to the content below the hero on first scroll/swipe/click,
    // instead of gradually scrolling through the empty full-viewport hero.
    let heroSkipController: AbortController | null = null;

    function initHeroSkip() {
        heroSkipController?.abort();
        heroSkipController = new AbortController();
        const { signal } = heroSkipController;

        const indicator = document.getElementById('scroll-indicator');
        const target = document.getElementById('hero-parallax');
        if (!indicator || !target) return;

        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let locked = false;

        function goToContent() {
            if (locked) return;
            locked = true;
            target?.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'start' });
            setTimeout(() => { locked = false; }, 800);
        }

        indicator.addEventListener('click', goToContent, { signal });

        function handleWheel(e: WheelEvent) {
            if (window.scrollY > 10 || e.deltaY <= 0) return;
            e.preventDefault();
            goToContent();
        }

        let touchStartY = 0;
        function handleTouchStart(e: TouchEvent) {
            touchStartY = e.touches[0]?.clientY ?? 0;
        }
        function handleTouchMove(e: TouchEvent) {
            if (window.scrollY > 10) return;
            const currentY = e.touches[0]?.clientY ?? touchStartY;
            if (touchStartY - currentY > 20) {
                e.preventDefault();
                goToContent();
            }
        }

        window.addEventListener('wheel', handleWheel, { passive: false, signal });
        window.addEventListener('touchstart', handleTouchStart, { passive: true, signal });
        window.addEventListener('touchmove', handleTouchMove, { passive: false, signal });
    }

    document.addEventListener('astro:page-load', initHeroSkip);
</script>
