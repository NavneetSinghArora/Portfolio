---
import { marked } from 'marked';
import type { Hero as HeroProps } from '../types';
import Button from './Button.astro';
import CustomImage from './CustomImage.astro';
import HeroDecoration from './LottieHero.astro';

type Props = HeroProps;

const { title, image, text, actions } = Astro.props;
---

{
    (title || image?.src || text || (actions && actions.length > 0)) && (
        <section id="hero-parallax" class="relative mb-16 flex w-full scroll-mt-24 flex-col gap-8 sm:mb-24 sm:scroll-mt-32 py-10 sm:py-16 px-4 sm:px-8" data-nn-layer="0" data-nn-delay="60">
            <HeroDecoration />
            <div class="relative z-10 flex w-full flex-col gap-8">
                {title && (
                    <div class="relative">
                        <!-- Subtle radial glow for readability -->
                        <div class="absolute inset-[-20%] -z-10 bg-main-bg/80 dark:bg-main-bg/60 blur-[40px] pointer-events-none rounded-full"></div>
                        <h1 class="relative font-serif text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">{title}</h1>
                    </div>
                )}
                {image?.src && (
                    <figure 
                        class="overflow-hidden rounded-2xl bg-main-bg/5"
                        style={typeof image.src === 'object' ? `aspect-ratio: ${image.src.width} / ${image.src.height}` : ''}
                    >
                        <CustomImage
                            class="w-full relative z-10"
                            {...image}
                            widths={[480, 640, 768, 1024, 1536]}
                            sizes="(min-width: 832px) 768px, calc(100vw - 32px)"
                            fetchpriority="high"
                            loading="eager"
                        />
                        {image.caption && <figcaption class="mt-1.5 text-xs sm:text-sm relative z-10">{image.caption}</figcaption>}
                    </figure>
                )}
                {(text || (actions && actions.length > 0)) && (
                    <div class="hero-inference-card spotlight-card group relative flex flex-col p-6 sm:p-8 mt-2 overflow-hidden">
                        <div class="spotlight-glow"></div>
                        {text && <div class="relative z-10 prose dark:prose-invert sm:prose-lg max-w-none prose-p:text-main/90 prose-p:leading-relaxed font-sans mt-2" set:html={marked.parse(text)} />}

                        <a href="/about" class="relative z-10 text-sm font-medium text-main/60 hover:text-main transition-colors mt-3 inline-block w-fit">
                            More about me →
                        </a>

                        {actions && actions.length > 0 && (
                            <div class="relative z-10 flex flex-wrap gap-4 mt-8">
                                {actions.map((action) => (
                                    <Button href={action.href} target={action.target} variant={action.variant}>
                                        {action.text}
                                    </Button>
                                ))}
                            </div>
                        )}
                        {/* <div class="relative z-10 mt-4 flex w-full">
                            <LiveCodingBadge />
                        </div> */}
                    </div>
                )}
            </div>
        </section>
    )
}

<script>
    // Mirrors Header.astro's hero-skip: the first scroll/swipe while resting
    // at the top of a section jumps straight to the adjacent one (down to the
    // next section, or back up to the previous one) instead of gradually
    // scrolling through it.
    let heroCardSkipController: AbortController | null = null;

    function initHeroCardSkip() {
        heroCardSkipController?.abort();
        heroCardSkipController = new AbortController();
        const { signal } = heroCardSkipController;

        const heroEl = document.getElementById('hero-parallax');
        const nextEl = document.getElementById('selected-work');
        if (!heroEl || !nextEl) return;

        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let locked = false;

        function isAtTop(el: HTMLElement) {
            const clearance = parseFloat(getComputedStyle(el).scrollMarginTop) || 0;
            return Math.abs(el.getBoundingClientRect().top - clearance) < 24;
        }

        function goTo(el: HTMLElement) {
            if (locked) return;
            locked = true;
            el.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'start' });
            setTimeout(() => { locked = false; }, 800);
        }

        function goToTop() {
            if (locked) return;
            locked = true;
            window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
            setTimeout(() => { locked = false; }, 800);
        }

        function handleDown() {
            if (isAtTop(heroEl!)) goTo(nextEl!);
        }

        function handleUp() {
            if (isAtTop(nextEl!)) goTo(heroEl!);
            else if (isAtTop(heroEl!)) goToTop();
        }

        function handleWheel(e: WheelEvent) {
            if (e.deltaY > 0) {
                if (!isAtTop(heroEl!)) return;
                e.preventDefault();
                handleDown();
            } else if (e.deltaY < 0) {
                if (!isAtTop(nextEl!) && !isAtTop(heroEl!)) return;
                e.preventDefault();
                handleUp();
            }
        }

        let touchStartY = 0;
        function handleTouchStart(e: TouchEvent) {
            touchStartY = e.touches[0]?.clientY ?? 0;
        }
        function handleTouchMove(e: TouchEvent) {
            const currentY = e.touches[0]?.clientY ?? touchStartY;
            const delta = touchStartY - currentY;
            if (delta > 20) {
                if (!isAtTop(heroEl!)) return;
                e.preventDefault();
                handleDown();
            } else if (delta < -20) {
                if (!isAtTop(nextEl!) && !isAtTop(heroEl!)) return;
                e.preventDefault();
                handleUp();
            }
        }

        window.addEventListener('wheel', handleWheel, { passive: false, signal });
        window.addEventListener('touchstart', handleTouchStart, { passive: true, signal });
        window.addEventListener('touchmove', handleTouchMove, { passive: false, signal });
    }

    document.addEventListener('astro:page-load', initHeroCardSkip);
</script>
