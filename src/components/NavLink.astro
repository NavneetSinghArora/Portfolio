---
import type { HTMLAttributes } from 'astro/types';

// `marker` opts this link into the sliding active-pill view transition. Only one
// link per document may carry the name — a duplicate view-transition-name aborts
// the whole transition — so the mobile menu renders its copies without it.
type Props = HTMLAttributes<'a'> & { marker?: boolean };

const { href, class: className, marker = false, ...props } = Astro.props;

const { pathname } = Astro.url;
const isActive = href === pathname || href === pathname.replace(/\/$/, '');
---

<a
    class:list={[
        className,
        { 'active-nav-link !bg-main hover:!bg-main/90 !text-main-bg shadow-lg shadow-main/20 scale-[1.02]': isActive }
    ]}
    style={isActive && marker ? "view-transition-name: active-nav-marker" : ""}
    href={href} 
    aria-current={isActive ? 'page' : undefined}
    {...props}
>
    <slot />
</a>
