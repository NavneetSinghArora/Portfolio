---
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import AuroraBackground from '../components/AuroraBackground.astro';
import CommandPalette from '../components/CommandPalette.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import ScrollToTop from '../components/ScrollToTop.astro';

export type Props = HeadProps & { showHeader?: boolean };

const { showHeader = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="en" class="wrap-break-words antialiased">
    <head>
        <BaseHead {...head} />
        <script>
            const storedTheme = localStorage.theme;
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (storedTheme === 'dark' || (storedTheme !== 'light' && prefersDark)) {
                document.documentElement.classList.add('dark');
            }
        </script>
        <ClientRouter />
        <script is:inline src="/theme-toggle.js"></script>
        <Analytics />
    </head>
    <body class="text-main bg-transparent overflow-x-hidden">
        <AuroraBackground />
        <CommandPalette />
        <div id="nn-progress-bar"><div id="nn-progress-fill"></div></div>
        <Nav />
        <div class="flex min-h-screen flex-col px-4 md:px-8 pt-24 sm:pt-32 relative z-10 w-full">
            {showHeader && <Header />}
            <main class="mx-auto w-full max-w-4xl grow">
                <slot />
            </main>
            <Footer />
        </div>

        <ScrollToTop />
        <SpeedInsights />
        
        <script>
            // rAF-throttled spotlight glow — desktop pointer only
            let handleMouseMove: ((e: MouseEvent) => void) | undefined;

            function initSpotlight() {
                if (window.matchMedia('(pointer: coarse)').matches) return;
                if (handleMouseMove) window.removeEventListener('mousemove', handleMouseMove);

                let rafId: number | null = null;
                let lastX = 0, lastY = 0;

                handleMouseMove = (e) => {
                    lastX = e.clientX;
                    lastY = e.clientY;
                    if (rafId !== null) return;
                    rafId = requestAnimationFrame(() => {
                        rafId = null;
                        const cards = document.querySelectorAll<HTMLElement>('.spotlight-card');
                        cards.forEach((card) => {
                            const rect = card.getBoundingClientRect();
                            const dx = lastX - (rect.left + rect.width / 2);
                            const dy = lastY - (rect.top + rect.height / 2);
                            if (dx * dx + dy * dy < 1_000_000) {
                                card.style.setProperty('--mx', `${lastX - rect.left}px`);
                                card.style.setProperty('--my', `${lastY - rect.top}px`);
                            }
                        });
                    });
                };

                window.addEventListener('mousemove', handleMouseMove, { passive: true });
            }

            initSpotlight();
            document.addEventListener('astro:page-load', initSpotlight);
        </script>

        <script>
            function initNeuralActivation() {
                document.body.classList.add('nn-ready');

                const targets = document.querySelectorAll(
                    '[data-nn-layer], .experience-card, .education-card'
                );
                if (!targets.length) return;

                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (!entry.isIntersecting) return;
                            const el = entry.target as HTMLElement;
                            const delay = parseInt(el.dataset.nnDelay || '0');
                            setTimeout(() => el.classList.add('nn-activated'), delay);
                            observer.unobserve(el);
                        });
                    },
                    { threshold: 0.07, rootMargin: '0px 0px -30px 0px' }
                );

                targets.forEach((el) => {
                    el.classList.add('nn-layer');
                    observer.observe(el);
                });
            }

            initNeuralActivation();
            document.addEventListener('astro:page-load', initNeuralActivation);
        </script>

        <script>
            // Phase 7: Neural scroll progress bar
            function initProgressBar() {
                const fill = document.getElementById('nn-progress-fill');
                if (!fill) return;

                function update() {
                    if (!fill) return;
                    const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
                    if (maxScroll <= 0) { fill.style.transform = 'scaleY(0)'; return; }
                    fill.style.transform = `scaleY(${Math.min(1, window.scrollY / maxScroll)})`;
                }

                window.addEventListener('scroll', update, { passive: true });
                update();
            }
            initProgressBar();
            document.addEventListener('astro:page-load', initProgressBar);
        </script>
    </body>
</html>
